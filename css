:root {
    --primary-color: #3498db;
    --dark-color: #2c3e50;
    --light-bg: #f8f9fa;
    --border-color: #e2e8f0;
    --expensive-color: #e74c3c;
    --budget-color: #2ecc71;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: var(--light-bg);
    color: var(--dark-color);
    padding: 20px;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

header {
    text-align: center;
    margin-bottom: 30px;
}

header h1 {
    margin-bottom: 10px;
}

#stats-container {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--primary-color);
}


#product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 25px;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
}


.product-card {
    background: #fff;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
}

.product-image {
    width: 100%;
    height: 180px;
    object-fit: contain;
    margin-bottom: 15px;
}

.product-title {
    font-size: 1.1rem;
    margin: 10px 0 5px 0;
    min-height: 44px; 
}

.product-category {
    font-size: 0.8rem;
    text-transform: uppercase;
    color: #7f8c8d;
    letter-spacing: 0.5px;
    margin-bottom: 10px;
}

.product-description {
    font-size: 0.9rem;
    color: #555;
    margin-bottom: 15px;
    line-height: 1.4;
}

.product-price {
    font-size: 1.3rem;
    font-weight: bold;
    color: var(--dark-color);
    margin-top: auto;
    margin-bottom: 15px;
}


.tag {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 4px 8px;
    font-size: 0.75rem;
    font-weight: bold;
    border-radius: 4px;
    color: white;
}

.tag.expensive {
    background-color: var(--expensive-color);
}

.tag.budget {
    background-color: var(--budget-color);
}


.card-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

button {
    padding: 8px 12px;
    border: 1px solid var(--primary-color);
    background-color: transparent;
    color: var(--primary-color);
    border-radius: 4px;
    cursor: pointer;
    font-weight: 500;
    transition: all 0.2s;
}

button:hover {
    background-color: var(--primary-color);
    color: white;
}

.btn-details {
    background-color: var(--dark-color);
    border-color: var(--dark-color);
    color: white;
}

.btn-details:hover {
    background-color: #1a252f;
}


.final {
    text-align: center;
    margin-top: auto;
    padding: 20px 0 10px 0;
    font-size: 0.9rem;
    color: #7f8c8d;
    font-style: italic;
}
