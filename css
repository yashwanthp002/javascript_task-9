
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    padding:20px;
    background:#f4f4f4;
}

h1{
    text-align:center;
    margin-bottom:20px;
}

.stats{
    font-size:20px;
    font-weight:bold;
    margin-bottom:20px;
}

.products{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
    gap:20px;
}

.card{
    background:white;
    padding:15px;
    border-radius:10px;
    box-shadow:0 0 10px rgba(0,0,0,0.1);
}

.card img{
    width:100%;
    height:250px;
    object-fit:contain;
}

.card h3{
    margin:10px 0;
}

.card p{
    margin:5px 0;
}

.tag{
    display:inline-block;
    padding:5px 10px;
    margin:10px 0;
    border-radius:5px;
    color:white;
}

.expensive{
    background:red;
}

.budget{
    background:green;
}

.buttons{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
    margin-top:10px;
}

button{
    padding:8px 12px;
    cursor:pointer;
}

.final{
    margin-top:30px;
    text-align:center;
    font-weight:bold;
    color:green;
}
